# Documentation only. This file has no active credential assignment and cannot
# satisfy install.sh. Generate a new value on the deployment host with:
# python3 -c 'import secrets; print(secrets.token_hex(32))'
# Then create /etc/sentinel-cps/gateway.env as root:root mode 0600 containing:
# SENTINEL_OPERATOR_TOKEN=<64 lowercase hexadecimal characters>
# When mitigation is enabled, use a different independently generated value:
# SENTINEL_MITIGATION_TOKEN=<separate mitigation credential>
